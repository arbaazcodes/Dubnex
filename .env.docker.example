# Copy to .env.docker and fill secrets before: docker compose up --build
# cp .env.docker.example .env.docker

# --- Postgres ---
POSTGRES_USER=screenai
POSTGRES_PASSWORD=screenai_change_me
POSTGRES_DB=screen_ai
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Published ports ---
API_PORT=8000
FRONTEND_PORT=80

# --- Public URLs / CORS ---
PUBLIC_BASE_URL=http://localhost
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80

# --- Auth (required for real login / protected APIs) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Storage (local in compose volumes; set s3 for cloud) ---
STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=
# S3_PREFIX=screen-ai

# --- Models (compose defaults favor CPU / faster first boot) ---
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Production GPU example:
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16

# Fail API boot if required checks fail (db/storage/firebase/whisper)
STRICT_STARTUP=false

# Job queue
QUEUE_BACKEND=redis
JOB_MAX_RETRIES=3

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
