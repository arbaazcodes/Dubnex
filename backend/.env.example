# Backend environment example — copy to .env and fill in secrets
# cp .env.example .env

# Server bind (documented for uvicorn: uvicorn app:app --host $HOST --port $PORT)
HOST=127.0.0.1
PORT=8000

# Public URL used in secure project video/download links (must be reachable by the browser)
# Example: http://127.0.0.1:8000/api/projects/{id}/video
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

# Working directories (relative to backend/ or absolute paths)
TEMP_DIR=temp
OUTPUT_DIR=outputs
DATA_DIR=data

# Project metadata database
# DATABASE_PROVIDER=sqlite|postgres|memory
#   sqlite   — local file DB (default, offline-friendly)
#   postgres — set DATABASE_URL (e.g. postgresql+psycopg://user:pass@host/db)
#   memory   — ephemeral in-process DB (no durable file)
DATABASE_PROVIDER=sqlite
DATABASE_URL=

# Object storage (local for development; s3 for cloud)
# STORAGE_PROVIDER=local|s3
STORAGE_PROVIDER=local
# Required when STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: MinIO / Cloudflare R2 / custom endpoint
S3_ENDPOINT_URL=
S3_PREFIX=screen-ai
# Signed URL lifetime in seconds (preview/download redirects)
S3_SIGNED_URL_EXPIRY=3600
# Delete local rendered MP4 after successful S3 upload
STORAGE_DELETE_LOCAL_AFTER_UPLOAD=true

# Redis / background job queue
# QUEUE_BACKEND=auto|redis|inline  (auto uses redis when REDIS_URL is set)
REDIS_URL=
QUEUE_BACKEND=auto
JOB_MAX_RETRIES=3
QUEUE_NAME=screen_ai:jobs

# Performance
TTS_CONCURRENCY=3
TRANSLATION_BATCH_SIZE=8
WHISPER_WARMUP=true
PERF_PROFILE=true

# Fail process start when required startup checks fail (recommended in production compose)
STRICT_STARTUP=false

# Faster-Whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# NLLB translation model id (Hugging Face)
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M

# Firebase (must match the frontend VITE_FIREBASE_PROJECT_ID)
# Used to verify Firebase ID tokens on protected routes
FIREBASE_PROJECT_ID=your-project
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_GEORGE=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_BUNTY=YOUR_BUNTY_VOICE_ID
ELEVENLABS_VOICE_JESSICA=YOUR_JESSICA_VOICE_ID
